# ---------------------------------------------------
# Global ignore: exclude everything by default
# ---------------------------------------------------
*

# ---------------------------------------------------
# Keep essential files
# ---------------------------------------------------
!.gitignore
!README.md
!LICENSE
!pyproject.toml
!uv.lock

# ---------------------------------------------------
# Root coursework folder
!Aprendizaje Automático Avanzado/

# Activity folders (include all files inside)
!Aprendizaje Automático Avanzado/AprendizajeAutomaticoAvanzado_U1/
!Aprendizaje Automático Avanzado/AprendizajeAutomaticoAvanzado_U2/
!Aprendizaje Automático Avanzado/AprendizajeAutomaticoAvanzado_U3/
!Aprendizaje Automático Avanzado/AprendizajeAutomaticoAvanzado_U4/

# Keep Python files inside activity folders
!Aprendizaje Automático Avanzado/AprendizajeAutomaticoAvanzado_U1/*.py
!Aprendizaje Automático Avanzado/AprendizajeAutomaticoAvanzado_U2/*.py
!Aprendizaje Automático Avanzado/AprendizajeAutomaticoAvanzado_U3/*.py
!Aprendizaje Automático Avanzado/AprendizajeAutomaticoAvanzado_U4/*.py

# ---------------------------------------------------
# Data folder (include CSV datasets)
!Aprendizaje Automático Avanzado/data/
!Aprendizaje Automático Avanzado/data/*.csv

# ---------------------------------------------------
# Explicitly ignore large/binary files
*.mp4
*.mov
*.avi
*.mkv
*.zip
*.rar
*.tar
*.gz

# ---------------------------------------------------
# Python build artifacts
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# ---------------------------------------------------
# Virtual environments
.venv/
.env/

# ---------------------------------------------------
# IDE/editor configs (optional, keeps repo clean)
.vscode/
.idea/


